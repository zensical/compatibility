{
  "plugins": [
    "autorefs",
    "blog"
  ],
  "check": [
    "publication",
    "references"
  ],
  "warm": true,
  "assertions": [
    {
      "path": "/publication/canonicals/index.html",
      "value": "https://example.test/docs/"
    },
    {
      "path": "/references/pages/index.html/links/0/url",
      "value": "https://example.test/docs/blog/2024/01/02/launch/#details"
    },
    {
      "path": "/references/pages/index.html/links/1/url",
      "value": "https://example.test/docs/blog/2024/01/02/launch/#details"
    }
  ],
  "purpose": "Heading aliases and direct source links must follow the final blog route after a slug change.",
  "steps": [
    {
      "name": "route-edit",
      "path": "docs/blog/posts/post.md",
      "before": "slug: launch",
      "after": "slug: revised",
      "clean": true,
      "changed": true,
      "assertions": [
        {
          "path": "/publication/canonicals/index.html",
          "value": "https://example.test/docs/"
        },
        {
          "path": "/references/pages/index.html/links/0/url",
          "value": "https://example.test/docs/blog/2024/01/02/revised/#details"
        },
        {
          "path": "/references/pages/index.html/links/1/url",
          "value": "https://example.test/docs/blog/2024/01/02/revised/#details"
        }
      ]
    }
  ]
}
