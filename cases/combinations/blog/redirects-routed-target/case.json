{
  "plugins": [
    "blog",
    "redirects"
  ],
  "check": [
    "publication",
    "redirects"
  ],
  "warm": true,
  "assertions": [
    {
      "path": "/publication/canonicals/index.html",
      "value": "https://example.test/docs/"
    },
    {
      "path": "/redirects/redirects/old-post~1index.html/canonical",
      "value": "../blog/2024/01/02/launch/"
    }
  ],
  "purpose": "Redirect destinations must use routed post URLs rather than Markdown source URLs.",
  "steps": [
    {
      "name": "route-edit",
      "path": "docs/blog/posts/post.md",
      "before": "slug: launch",
      "after": "slug: revised",
      "clean": true,
      "changed": true,
      "assertions": [
        {
          "path": "/publication/canonicals/index.html",
          "value": "https://example.test/docs/"
        },
        {
          "path": "/redirects/redirects/old-post~1index.html/canonical",
          "value": "../blog/2024/01/02/revised/"
        }
      ]
    }
  ]
}
