{
  "plugins": [
    "git-revision-date-localized",
    "meta"
  ],
  "check": [
    "publication",
    "git-revision-dates"
  ],
  "purpose": "An inherited page locale is used for Git date formatting, and uncommitted metadata changes reformat cached commit timestamps.",
  "warm": true,
  "strict": true,
  "git": {
    "commits": [
      {
        "name": "created",
        "date": "2024-01-01T08:00:00+00:00"
      },
      {
        "name": "updated",
        "date": "2024-02-02T12:34:56+00:00",
        "path": "docs/index.md",
        "before": "COMPAT_BASE",
        "after": "COMPAT_UPDATED",
        "tag": "v1"
      }
    ]
  },
  "assertions": [
    {
      "path": "/publication/probes/index.html/custom",
      "value": "02. février 2024"
    },
    {
      "path": "/publication/probes/index.html/inline-revision",
      "value": "02. février 2024"
    }
  ],
  "steps": [
    {
      "name": "change-inherited-locale",
      "path": "docs/.meta.yml",
      "before": "locale: fr_FR",
      "after": "locale: de",
      "changed": true,
      "assertions": [
        {
          "path": "/publication/probes/index.html/custom",
          "value": "02. Februar 2024"
        },
        {
          "path": "/publication/probes/index.html/revision",
          "value": "2024-02-02 12:34:56"
        }
      ]
    }
  ]
}
