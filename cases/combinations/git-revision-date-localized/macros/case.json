{
  "plugins": [
    "git-revision-date-localized",
    "macros"
  ],
  "check": [
    "publication",
    "git-revision-dates"
  ],
  "purpose": "Raw revision metadata is available to macros when Git dates are configured before the macro plugin.",
  "warm": true,
  "strict": true,
  "git": {
    "commits": [
      {
        "name": "created",
        "date": "2024-01-01T08:00:00+00:00"
      },
      {
        "name": "updated",
        "date": "2024-02-02T12:34:56+00:00",
        "path": "docs/index.md",
        "before": "COMPAT_BASE",
        "after": "COMPAT_UPDATED",
        "tag": "v1"
      }
    ]
  },
  "assertions": [
    {
      "path": "/publication/probes/index.html/macro",
      "value": "2024-02-02"
    },
    {
      "path": "/publication/probes/index.html/revision",
      "value": "2024-02-02 12:34:56"
    }
  ]
}
