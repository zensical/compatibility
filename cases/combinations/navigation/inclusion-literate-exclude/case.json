{
  "plugins": [
    "literate-nav",
    "exclude"
  ],
  "check": [
    "navigation",
    "publication"
  ],
  "warm": true,
  "purpose": "Literate-nav explicit unlisted links are combined with core publication patterns and overlapping exclude-plugin globs.",
  "assertions": [
    {
      "path": "/publication/routes",
      "value": [
        "index.html",
        "public/index.html",
        "unlisted/index.html"
      ]
    },
    {
      "path": "/publication/sitemap",
      "value": [
        "https://example.test/docs/",
        "https://example.test/docs/public/",
        "https://example.test/docs/unlisted/"
      ]
    },
    {
      "path": "/publication/search",
      "value": {
        "": [
          "COMPAT_HOME"
        ],
        "public/": [
          "COMPAT_PUBLIC"
        ],
        "unlisted/": [
          "COMPAT_UNLISTED"
        ]
      }
    },
    {
      "path": "/publication/probes/index.html/PAGES",
      "value": "|public/|unlisted/"
    }
  ]
}
