{
  "plugins": [
    "privacy",
    "exclude"
  ],
  "check": "privacy",
  "purpose": "Core-excluded pages, plugin-excluded pages, and excluded CSS are omitted before privacy downloads are scheduled.",
  "warm": true,
  "http": {
    "directory": "remote",
    "requests": {
      "cold": {
        "/image.png": 1
      },
      "warm": {}
    }
  },
  "assertions": [
    {
      "path": "/pages/index.html/image/attributes/src",
      "value": "assets/external/privacy.test/image.png"
    },
    {
      "path": "/assets/assets~1external~1privacy.test~1image.png/sha256",
      "value": "6b1048f8a6d40bac0b2954c18fefa40c4ea7a96120fc2e54b7317c0e43c2bbec"
    }
  ]
}
