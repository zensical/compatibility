{
  "plugins": [
    "tags",
    "meta"
  ],
  "check": [
    "meta",
    "tag-content",
    "search",
    "publication"
  ],
  "purpose": "Reverse tags/meta declaration order while retaining inherited tag, search-exclusion and page lifecycle contracts.",
  "warm": true,
  "assertions": [
    {
      "path": "/tag-content/index.html/listings",
      "value": [
        {
          "id": "tag:python",
          "tag": "Python",
          "links": [
            {
              "title": "Guide",
              "url": "https://example.test/docs/guides/one/"
            }
          ]
        }
      ]
    },
    {
      "path": "/meta/pages/guides~1one~1index.html/tags",
      "value": [
        "Python"
      ]
    },
    {
      "path": "/search/sections",
      "value": [
        {
          "location": "",
          "title": "Catalog",
          "tokens": [],
          "tags": []
        },
        {
          "location": "#tag:python",
          "title": "Python",
          "tokens": [],
          "tags": []
        },
        {
          "location": "guides/one/",
          "title": "Guide",
          "tokens": [
            "COMPAT_GUIDE"
          ],
          "tags": [
            "Python"
          ]
        }
      ]
    }
  ],
  "steps": [
    {
      "name": "inherited-tag",
      "path": "docs/guides/.meta.yml",
      "before": "- Python",
      "after": "- Rust",
      "changed": true,
      "assertions": [
        {
          "path": "/tag-content/index.html/listings",
          "value": [
            {
              "id": "tag:rust",
              "tag": "Rust",
              "links": [
                {
                  "title": "Guide",
                  "url": "https://example.test/docs/guides/one/"
                }
              ]
            }
          ]
        },
        {
          "path": "/meta/pages/guides~1one~1index.html/tags",
          "value": [
            "Rust"
          ]
        },
        {
          "path": "/search/sections",
          "value": [
            {
              "location": "",
              "title": "Catalog",
              "tokens": [],
              "tags": []
            },
            {
              "location": "#tag:rust",
              "title": "Rust",
              "tokens": [],
              "tags": []
            },
            {
              "location": "guides/one/",
              "title": "Guide",
              "tokens": [
                "COMPAT_GUIDE"
              ],
              "tags": [
                "Rust"
              ]
            }
          ]
        }
      ],
      "differences": [
        {
          "path": "/meta/extends/guides~1one~1index.html",
          "mkdocs": [
            "guides/.meta.yml"
          ],
          "zensical": [],
          "reason": "Material exposes its private __extends bookkeeping; Zensical keeps it internal."
        }
      ]
    },
    {
      "name": "inherited-exclusion",
      "path": "docs/guides/.meta.yml",
      "before": "exclude: false",
      "after": "exclude: true",
      "changed": true,
      "assertions": [
        {
          "path": "/publication/search",
          "value": {
            "": []
          }
        },
        {
          "path": "/tag-content/index.html/listings",
