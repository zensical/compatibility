{
  "plugins": [
    "awesome-nav"
  ],
  "check": [
    "navigation",
    "publication"
  ],
  "warm": true,
  "purpose": "Awesome-nav control files remain usable despite default exclusions; explicit entries and globs are combined with core and plugin navigation filters.",
  "assertions": [
    {
      "path": "/publication/routes",
      "value": [
        "index.html",
        "plugin-hidden/index.html",
        "public/index.html",
        "unlisted/index.html",
        "visible/index.html"
      ]
    },
    {
      "path": "/publication/sitemap",
      "value": [
        "https://example.test/docs/",
        "https://example.test/docs/plugin-hidden/",
        "https://example.test/docs/public/",
        "https://example.test/docs/unlisted/",
        "https://example.test/docs/visible/"
      ]
    },
    {
      "path": "/publication/search",
      "value": {
        "": [
          "COMPAT_HOME"
        ],
        "plugin-hidden/": [
          "COMPAT_PLUGIN_HIDDEN"
        ],
        "public/": [
          "COMPAT_PUBLIC"
        ],
        "unlisted/": [
          "COMPAT_UNLISTED"
        ],
        "visible/": [
          "COMPAT_VISIBLE"
        ]
      }
    },
    {
      "path": "/publication/probes/index.html/PAGES",
      "value": "|public/|visible/",
      "engine": "mkdocs"
    },
    {
      "path": "/publication/probes/index.html/PAGES",
      "engine": "zensical",
      "value": "|public/|unlisted/|visible/"
    }
  ],
  "known_gap": "Awesome-nav globs restore core unlisted pages only in Zensical.",
  "differences": [
    {
      "path": "/navigation/navigation",
      "zensical_only": {
        "title": "Unlisted",
        "url": "https://example.test/docs/unlisted/"
      },
      "reason": "MkDocs awesome-nav filters not_in_nav pages before matching globs; Zensical restores matched unlisted pages."
    },
    {
      "path": "/publication/probes/index.html/PAGES",
      "mkdocs": "|public/|visible/",
      "zensical": "|public/|unlisted/|visible/",
      "reason": "MkDocs awesome-nav filters not_in_nav pages before matching globs; Zensical restores matched unlisted pages."
    },
    {
      "path": "/publication/probes/plugin-hidden~1index.html/PAGES",
      "mkdocs": "|public/|visible/",
      "zensical": "|public/|unlisted/|visible/",
      "reason": "MkDocs awesome-nav filters not_in_nav pages before matching globs; Zensical restores matched unlisted pages."
    },
    {
      "path": "/publication/probes/public~1index.html/PAGES",
      "mkdocs": "|public/|visible/",
      "zensical": "|public/|unlisted/|visible/",
      "reason": "MkDocs awesome-nav filters not_in_nav pages before matching globs; Zensical restores matched unlisted pages."
    },
    {
      "path": "/publication/probes/unlisted~1index.html/PAGES",
      "mkdocs": "|public/|visible/",
      "zensical": "|public/|unlisted/|visible/",
      "reason": "MkDocs awesome-nav filters not_in_nav pages before matching globs; Zensical restores matched unlisted pages."
    },
    {
      "path": "/publication/probes/visible~1index.html/PAGES",
      "mkdocs": "|public/|visible/",
      "zensical": "|public/|unlisted/|visible/",
      "reason": "MkDocs awesome-nav filters not_in_nav pages before matching globs; Zensical restores matched unlisted pages."
    }
  ]
}
