{
  "plugins": [
    "awesome-nav"
  ],
  "check": "navigation",
  "warm": true,
  "source": "plugin-awesome-nav",
  "assertions": [
    {
      "path": "/navigation/0/title",
      "value": "Home"
    },
    {
      "path": "/navigation/1/title",
      "value": "Guides"
    },
    {
      "path": "/navigation/1/children/1/title",
      "value": "Quick start"
    }
  ]
}
