{
  "plugins": [
    "material/blog"
  ],
  "check": "blog",
  "source": "zensical-blog-parity/cases/empty-blog",
  "assertions": [
    {
      "path": "/pages",
      "count": 2
    },
    {
      "path": "/pages/index.html/canonical",
      "value": "/"
    }
  ],
  "warm": true,
  "differences": [
    {
      "path": "/navigation/1/children",
      "mkdocs": [
        {
          "children": [],
          "title": "Archive",
          "url": "/"
        }
      ],
      "zensical": [],
      "reason": "Upstream creates an empty Archive child pointing to the root; native omits the empty archive navigation item."
    },
    {
      "path": "/pages/index.html/document_title",
      "mkdocs": "Empty blog parity",
      "zensical": "Home - Empty blog parity",
      "reason": "Native HTML retains the configured home navigation label in the browser title; upstream uses only the site title."
    }
  ]
}
