{
  "plugins": [
    "git-revision-date-localized"
  ],
  "check": [
    "publication",
    "git-revision-dates"
  ],
  "purpose": "A disabled plugin leaves metadata and placeholders untouched and does not validate unused time-zone settings.",
  "warm": true,
  "strict": true,
  "git": {
    "commits": [
      {
        "name": "created",
        "date": "2024-01-01T08:00:00+00:00"
      },
      {
        "name": "updated",
        "date": "2024-02-02T12:34:56+00:00",
        "path": "docs/index.md",
        "before": "COMPAT_BASE",
        "after": "COMPAT_UPDATED",
        "tag": "v1"
      }
    ]
  },
  "assertions": [
    {
      "path": "/publication/probes/index.html/revision",
      "value": ""
    },
    {
      "path": "/publication/probes/index.html/inline-revision",
      "value": "{{ git_revision_date_localized }}"
    }
  ]
}
