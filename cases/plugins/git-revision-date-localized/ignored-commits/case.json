{
  "plugins": [
    "git-revision-date-localized"
  ],
  "check": [
    "publication",
    "git-revision-dates"
  ],
  "purpose": "Abbreviated ignored hashes, comments, and blank lines affect revision lookup but preserve creation history; ignore-file edits invalidate cached results.",
  "warm": true,
  "strict": true,
  "git": {
    "commits": [
      {
        "name": "created",
        "date": "2024-01-01T08:00:00+00:00"
      },
      {
        "name": "updated",
        "date": "2024-02-02T12:34:56+00:00",
        "path": "docs/index.md",
        "before": "COMPAT_BASE",
        "after": "COMPAT_UPDATED",
        "tag": "v1"
      },
      {
        "name": "formatting",
        "date": "2024-03-03T10:11:12+00:00",
        "path": "docs/index.md",
        "before": "COMPAT_UPDATED",
        "after": "COMPAT_FORMATTED"
      }
    ],
    "ignored_commits_file": ".git-blame-ignore-revs",
    "ignored_commits": [
      "formatting"
    ]
  },
  "assertions": [
    {
      "path": "/publication/probes/index.html/revision",
      "value": "2024-02-02 12:34:56"
    },
    {
      "path": "/publication/probes/index.html/creation",
      "value": "2024-01-01 08:00:00"
    }
  ],
  "steps": [
    {
      "name": "clear-ignore-file",
      "copy": {
        "inputs/empty-ignore.txt": ".git-blame-ignore-revs"
      },
      "changed": true,
      "assertions": [
        {
          "path": "/publication/probes/index.html/revision",
          "value": "2024-03-03 10:11:12"
        },
        {
          "path": "/publication/probes/index.html/creation",
          "value": "2024-01-01 08:00:00"
        }
      ]
    }
  ]
}
