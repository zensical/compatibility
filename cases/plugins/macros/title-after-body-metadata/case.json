{
  "plugins": [
    "macros"
  ],
  "check": [
    "publication",
    "navigation"
  ],
  "warm": true,
  "assertions": [
    {
      "path": "/publication/probes/index.html/PAGE_TITLE",
      "value": "Title 2"
    },
    {
      "path": "/publication/probes/index.html/BODY",
      "value": "Title {{ next_number() }}"
    },
    {
      "path": "/publication/probes/index.html/META_TITLE",
      "value": "Title 2",
      "engine": "zensical"
    },
    {
      "path": "/publication/probes/index.html/META_TITLE",
      "engine": "mkdocs",
      "value": "Title {{ next_number() }}"
    },
    {
      "path": "/navigation/navigation/0/title",
      "value": "Title 2"
    }
  ],
  "purpose": "The body is rendered before the effective title; rendered titles are retained on warm builds.",
  "differences": [
    {
      "path": "/publication/probes/index.html/META_TITLE",
      "mkdocs": "Title {{ next_number() }}",
      "zensical": "Title 2",
      "reason": "The rendered metadata title is supplied to theme templates by Zensical; the source metadata is retained by MkDocs Macros."
    }
  ]
}
