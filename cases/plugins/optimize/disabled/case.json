{
  "plugins": [
    "material/optimize"
  ],
  "check": "optimize",
  "purpose": "Disabled image processing is checked with invalid image bytes that must be copied unchanged.",
  "warm": true,
  "assertions": [
    {
      "path": "/assets/assets~1optimize~1photo.jpg/unchanged",
      "value": true
    },
    {
      "path": "/assets/assets~1optimize~1diagram.png/unchanged",
      "value": true
    }
  ]
}
