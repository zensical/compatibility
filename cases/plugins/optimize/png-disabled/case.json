{
  "plugins": [
    "material/optimize"
  ],
  "check": "optimize",
  "purpose": "JPEG optimization is retained while PNG bytes are copied unchanged.",
  "warm": true,
  "assertions": [
    {
      "path": "/assets/assets~1optimize~1photo.jpg/smaller",
      "value": true
    },
    {
      "path": "/assets/assets~1optimize~1diagram.png/unchanged",
      "value": true
    }
  ]
}
