{
  "plugins": [
    "privacy"
  ],
  "check": "privacy",
  "purpose": "External images and original HTML attributes are retained when the entire privacy instance is disabled.",
  "warm": true,
  "http": {
    "directory": "remote",
    "requests": {
      "cold": {},
      "warm": {}
    }
  },
  "assertions": [
    {
      "path": "/pages/index.html/image/attributes/src",
      "value": "http://privacy.test/image.png"
    },
    {
      "path": "/assets",
      "value": {}
    }
  ]
}
