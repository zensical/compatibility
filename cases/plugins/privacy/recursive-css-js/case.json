{
  "plugins": [
    "privacy"
  ],
  "check": "privacy",
  "purpose": "Dependencies in local CSS and JavaScript are downloaded recursively; fonts, JSON, and rewritten output references are compared.",
  "warm": true,
  "http": {
    "directory": "remote",
    "requests": {
      "cold": {
        "/image.png": 1,
        "/font.css": 1,
        "/font.woff2": 1,
        "/dependency.js": 1,
        "/data.json": 1
      },
      "warm": {}
    },
    "local_assets": [
      "styles/site.css",
      "assets/loader.js"
    ]
  },
  "assertions": [
    {
      "path": "/pages/index.html/image/attributes/src",
      "value": "assets/external/privacy.test/image.png"
    },
    {
      "path": "/assets/assets~1external~1privacy.test~1image.png/sha256",
      "value": "6b1048f8a6d40bac0b2954c18fefa40c4ea7a96120fc2e54b7317c0e43c2bbec"
    },
    {
      "path": "/assets/assets~1external~1privacy.test~1font.css/urls",
      "value": [
        "font.woff2"
      ]
    },
    {
      "engine": "mkdocs",
      "path": "/assets/assets~1external~1privacy.test~1dependency.js/strings",
      "value": [
        "data.json"
      ]
    },
    {
      "engine": "zensical",
      "path": "/assets/assets~1external~1privacy.test~1dependency.js/strings",
      "value": [
        "/docs/assets/external/privacy.test/data.json"
      ]
    }
  ],
  "differences": [
    {
      "path": "/assets/assets~1external~1privacy.test~1dependency.js/strings/0",
      "mkdocs": "data.json",
      "zensical": "/docs/assets/external/privacy.test/data.json",
      "reason": "JavaScript dependencies are resolved against the site's base path by Zensical so references work from nested pages."
    },
    {
      "path": "/assets/assets~1loader.js/strings/0",
      "mkdocs": "https://example.test/docs/assets/external/privacy.test/dependency.js",
      "zensical": "/docs/assets/external/privacy.test/dependency.js",
      "reason": "The site's base path is retained by Zensical while the current origin is used for local previews."
    }
  ]
}
