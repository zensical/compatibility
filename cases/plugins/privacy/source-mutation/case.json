{
  "plugins": [
    "privacy"
  ],
  "check": "privacy",
  "purpose": "An image URL is replaced without a clean build; the new request, target, and output change are checked.",
  "warm": true,
  "http": {
    "directory": "remote",
    "requests": {
      "cold": {
        "/image.png": 1
      },
      "warm": {},
      "replace-image": {
        "/second.png": 1
      }
    }
  },
  "assertions": [
    {
      "path": "/pages/index.html/image/attributes/src",
      "value": "assets/external/privacy.test/image.png"
    },
    {
      "path": "/assets/assets~1external~1privacy.test~1image.png/sha256",
      "value": "6b1048f8a6d40bac0b2954c18fefa40c4ea7a96120fc2e54b7317c0e43c2bbec"
    }
  ],
  "steps": [
    {
      "name": "replace-image",
      "path": "docs/index.md",
      "before": "/image.png",
      "after": "/second.png",
      "changed": true,
      "assertions": [
        {
          "path": "/pages/index.html/image/attributes/src",
          "value": "assets/external/privacy.test/second.png"
        }
      ]
    }
  ]
}
