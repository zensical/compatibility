{
  "plugins": [
    "search"
  ],
  "check": [
    "navigation",
    "publication"
  ],
  "warm": true,
  "purpose": "Anchors, recursive directories, character classes, escaped prefixes, comments and ordered negations are checked for exclude_docs with Unicode paths.",
  "assertions": [
