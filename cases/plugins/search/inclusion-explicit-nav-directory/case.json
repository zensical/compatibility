{
  "plugins": [
    "search"
  ],
  "check": [
    "navigation",
    "publication"
  ],
  "warm": true,
  "purpose": "Explicit navigation restores an unlisted page while other unlisted pages remain published, searchable and in the sitemap.",
  "assertions": [
    {
      "path": "/publication/routes",
      "value": [
        "index.html",
        "public/index.html",
        "unlisted/index.html"
      ]
    },
    {
      "path": "/publication/sitemap",
      "value": [
        "https://example.test/docs/",
        "https://example.test/docs/public/",
        "https://example.test/docs/unlisted/"
      ]
    },
    {
      "path": "/publication/search",
      "value": {
        "": [
          "COMPAT_HOME"
        ],
        "public/": [
          "COMPAT_PUBLIC"
        ],
        "unlisted/": [
          "COMPAT_UNLISTED"
        ]
      }
    },
    {
      "path": "/publication/probes/index.html/PAGES",
      "value": "|unlisted/"
    }
  ]
}
